# Copie para .env.local (desenvolvimento) ou configure em
# Vercel → Project → Settings → Environment Variables.
# Todas são públicas (vão para o bundle do navegador): nunca coloque
# chaves secretas aqui.

# WhatsApp com DDI + DDD + número, só dígitos. Ex.: 5511999998888
VITE_WHATSAPP_NUMBER=

# E-mail de contato exibido no site (opcional)
VITE_CONTACT_EMAIL=

# Endpoint que recebe o formulário via POST JSON (Formspree, Web3Forms,
# função serverless própria...). Vazio = formulário não envia e o site
# oferece WhatsApp/e-mail como alternativa.
VITE_FORM_ENDPOINT=

# WhatsApp da landing page demonstrativa Vetra Academia (opcional).
# Vazio = os botões mostram a mensagem que seria enviada, sem abrir conversa.
VITE_VETRA_WHATSAPP=

# Domínio final, usado em links canônicos (opcional)
VITE_SITE_URL=
